{
    "name": "databox-indexer",
    "version": "1.0.0",
    "private": true,
    "description": "Consumes S3 events from AMQP and synchronize Databox",
    "main": "dist/console.mjs",
    "license": "MIT",
    "scripts": {
        "console": "node dist/console.mjs",
        "dev": "nodemon",
        "validate": "tsc -p ./tsconfig.check.json",
        "typecheck": "pnpm validate",
        "build": "pnpm validate && rimraf ./dist && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "sync-databox-types": "generate-api-platform-client --generator typescript http://databox-api src/",
        "format": "prettier --ignore-path .prettierignore --write \"**/*.+(js|ts|json|cjs|tsx|jsx)\"",
        "format:check": "prettier --ignore-path .prettierignore --check \"**/*.+(js|ts|json|cjs|tsx|jsx)\"",
        "lint": "eslint src tests",
        "lint:fix": "eslint --fix src tests",
        "cs": "pnpm lint:fix && pnpm format"
    },
    "dependencies": {
        "@alchemy/api": "workspace:*",
        "@alchemy/auth": "workspace:*",
        "@alchemy/storage": "workspace:*",
        "amqplib": "^0.10.9",
        "axios": "^1.20.0",
        "axios-retry": "^4.5.0",
        "chokidar": "^3.6.0",
        "commander": "^11.1.0",
        "express": "^4.22.3",
        "js-yaml": "^5.5.0",
        "minio": "^7.1.3",
        "twig": "^1.17.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@api-platform/create-client": "^0.10.0",
        "@types/amqplib": "^0.10.8",
        "@types/express": "^4.17.25",
        "@types/minio": "^7.1.1",
        "@types/node": "^18.19.130",
        "@types/supertest": "^6.0.3",
        "@types/twig": "^1.12.17",
        "axios-mock-adapter": "^2.1.0",
        "nodemon": "^3.1.14",
        "rimraf": "^5.0.10",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vite-plugin-node": "^7.0.0",
        "vitest": "^3.2.7"
    }
}
