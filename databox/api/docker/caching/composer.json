    "require-dev": {
        "api-platform/test": "^5.0",
        "alchemy/api-test": "@dev",
        "friendsofphp/php-cs-fixer": "^3.17",
        "justinrainbow/json-schema": "^5.2",
        "lcobucci/clock": "^3.1",
        "php-parallel-lint/php-var-dump-check": "v0.5",
        "phpstan/phpstan": "^2.1.33",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.5.1",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "config": {
        "process-timeout": 1800,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\Unit\\": "tests/unit/",
            "App\\Tests\\Functional\\": "tests/functional/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "cache-clear": "php -d memory_limit=-1 bin/console cache:clear",
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@cache-clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@cache-clear",
            "@auto-scripts"
        ],
        "rector": "vendor/bin/rector",
        "phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse -c phpstan.neon",
        "cs": "vendor/bin/php-cs-fixer fix",
        "pre-phpunit": [
            "rm -f var/cache/test/data*.db",
            "bin/console -e test doctrine:schema:create",
            "bin/console -e test fos:elastica:reset"
        ],
        "phpunit": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit"
        ],
        "phpunit:compact": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit --extension 'Alchemy\\ApiTest\\PHPUnit\\CompactResultExtension'"
        ],
        "var-dump-check": "vendor/bin/var-dump-check --symfony src",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@var-dump-check",
            "@phpstan",
            "@cs:check"
        ],
        "phpunit:unit": "php -d memory_limit=1024M vendor/bin/phpunit --testsuite unit",
        "phpunit:functional": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit --testsuite functional"
        ],
        "test:quick": [
            "@lint",
            "@phpunit:unit"
        ],
        "test": [
            "@lint",
            "@phpunit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    }
}
