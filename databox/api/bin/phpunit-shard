#!/usr/bin/env php
<?php

/*
 * Runs one shard of the functional suite, so that CI jobs can share it.
 *
 * The *Test.php files of tests/functional, sorted, are dealt round-robin over
 * N shards: file k (from 0) goes to shard k % N + 1. A big directory is thus
 * spread over every shard, and a new test file is picked up without any list
 * to maintain. The shards of 1/N to N/N together run the functional suite.
 *
 * The test database and the Elasticsearch indices must be ready
 * (composer pre-phpunit), as for bin/phpunit.
 *
 * Usage: php -d memory_limit=1024M bin/phpunit-shard I/N [--list-files] [phpunit options…]
 *   --list-files   print the test files of the shard instead of running them
 */

$usage = "Usage: bin/phpunit-shard I/N [--list-files] [phpunit options...]\n";

if ($argc < 2 || !preg_match('#^([1-9]\d*)/([1-9]\d*)$#', $argv[1], $matches) || (int) $matches[1] > (int) $matches[2]) {
    fwrite(STDERR, $usage);
    exit(2);
}

$shard = (int) $matches[1];
$shardCount = (int) $matches[2];
$phpunitArgs = array_slice($argv, 2);
$listOnly = in_array('--list-files', $phpunitArgs, true);
$phpunitArgs = array_values(array_diff($phpunitArgs, ['--list-files']));

$root = dirname(__DIR__);
chdir($root);

$files = [];
$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator('tests/functional', FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
    if (str_ends_with($file->getFilename(), 'Test.php')) {
        $files[] = $file->getPathname();
    }
}
sort($files, SORT_STRING);

$shardFiles = [];
foreach ($files as $k => $file) {
    if ($k % $shardCount === $shard - 1) {
        $shardFiles[] = $file;
    }
}

if ($listOnly) {
    foreach ($shardFiles as $file) {
        echo $file, "\n";
    }
    exit(0);
}

// Without a path argument, PHPUnit would run every suite of phpunit.xml.dist.
if ([] === $shardFiles) {
    echo sprintf("No test file in shard %d/%d.\n", $shard, $shardCount);
    exit(0);
}

echo sprintf("Shard %d/%d: %d of the %d files of tests/functional.\n", $shard, $shardCount, count($shardFiles), count($files));

$_SERVER['argv'] = $GLOBALS['argv'] = ['bin/phpunit', ...$phpunitArgs, ...$shardFiles];
$_SERVER['argc'] = $GLOBALS['argc'] = count($_SERVER['argv']);

require $root.'/bin/phpunit';
