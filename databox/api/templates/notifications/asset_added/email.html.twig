{% block subject %}New asset in {{ collectionName|default('a collection') }}{% endblock %}

{% block body %}
    <p>Hello {{ recipient.displayName|default(recipient.email) }},</p>

    <p>
        A new asset was added to
        <strong>{{ collectionName|default(collectionId) }}</strong>{% if workspaceName is defined and workspaceName %} in workspace <em>{{ workspaceName }}</em>{% endif %}.
    </p>

    <p>Asset reference: <code>{{ assetId }}</code></p>
{% endblock %}
