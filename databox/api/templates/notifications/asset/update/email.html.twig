{% block subject %}{{ 'asset.update.email.subject'|trans({'%name%': name}, 'notifications')|raw }}{% endblock %}

{% block body %}{% if collection is defined and collection %}{{ 'asset.update.email.body_with_collection'|trans({
    '%recipient%': (recipient.displayName|default(recipient.email))|e,
    '%author%': author|e,
    '%name%': name|e,
    '%url%': notification_url(url)|e('html_attr'),
    '%collection%': collection|e,
}, 'notifications')|raw }}{% else %}{{ 'asset.update.email.body'|trans({
    '%recipient%': (recipient.displayName|default(recipient.email))|e,
    '%author%': author|e,
    '%name%': name|e,
    '%url%': notification_url(url)|e('html_attr'),
}, 'notifications')|raw }}{% endif %}{% endblock %}
