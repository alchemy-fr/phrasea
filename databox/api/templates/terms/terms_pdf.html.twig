<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #222;
            margin: 40px;
        }
        header {
            margin-bottom: 30px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 15px;
        }
        header img {
            max-height: 60px;
        }
        h1 {
            font-size: 20px;
            margin: 10px 0 0;
        }
        .meta {
            color: #777;
            font-size: 10px;
            margin-top: 5px;
        }
        .content {
            line-height: 1.5;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>
<header>
    {% if logo %}
        <img src="{{ logo }}" alt="{{ workspaceName }}"/>
    {% endif %}
    <h1>{{ 'Terms & Conditions' }}</h1>
    <div class="meta">{{ workspaceName }} — version {{ version }} — {{ date|date('Y-m-d') }}</div>
</header>
<div class="content">{{ text|nl2br }}</div>
</body>
</html>
