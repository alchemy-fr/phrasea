{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Add a populate pass{% endblock %}

{% block main %}
    <p class="text-muted">
        A populate rebuilds the Elasticsearch documents from the database. It runs in the background
        (worker queue) and one pass is recorded per index. Populating every index can take a long time on
        a large instance: prefer targeting the index you actually changed.
    </p>

    <form method="post" action="" id="populate-pass-add-form" class="mt-3" style="max-width: 40em">
        <input type="hidden" name="token" value="{{ csrf_token(constant('App\\Controller\\Admin\\PopulatePassCrudController::CSRF_TOKEN_ID')) }}">

        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="scope" id="populate-scope-all" value="all" checked>
            <label class="form-check-label" for="populate-scope-all"><strong>All indices</strong></label>
            <div class="text-muted small">{{ indices|join(', ') }}</div>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="scope" id="populate-scope-selected" value="selected">
            <label class="form-check-label" for="populate-scope-selected"><strong>Only the selected indices</strong></label>
        </div>
        <div class="mb-3 ms-4" id="populate-indices">
            {% for index in indices %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="indices[]" value="{{ index }}" id="populate-index-{{ index }}" disabled>
                    <label class="form-check-label" for="populate-index-{{ index }}"><code>{{ index }}</code></label>
                </div>
            {% endfor %}
        </div>

        <button type="submit" class="btn btn-primary"><i class="fa fa-play"></i> Start populate</button>
        <a href="{{ indexUrl }}" class="btn btn-secondary">Cancel</a>
    </form>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        (function () {
            var checkboxes = document.querySelectorAll('#populate-indices input[type="checkbox"]');
            var radios = document.querySelectorAll('input[name="scope"]');
            var selectedRadio = document.getElementById('populate-scope-selected');
            var submit = document.querySelector('#populate-pass-add-form button[type="submit"]');
            function sync() {
                // checkboxes are only enabled (and submitted) with the "selected indices" scope
                var selected = selectedRadio.checked;
                var any = false;
                checkboxes.forEach(function (c) { c.disabled = !selected; any = any || (selected && c.checked); });
                submit.disabled = selected && !any;
            }
            radios.forEach(function (r) { r.addEventListener('change', sync); });
            checkboxes.forEach(function (c) { c.addEventListener('change', sync); });
            sync();
        })();
    </script>
{% endblock %}
