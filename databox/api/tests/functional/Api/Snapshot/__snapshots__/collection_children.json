                "property": "parent",
                "required": false,
                "variable": "parent"
            }
        ],
        "template": "/collections{?parent}",
        "variableRepresentation": "BasicRepresentation"
    },
    "totalItems": 1,
    "view": {
        "@id": "/collections?parent=<root>",
        "@type": "PartialCollectionView"
    }
