# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=disabled
PANTHER_APP_ENV=panther
DB_NAME=expose-test
EXPOSE_CLIENT_URL=https://expose.test
# High enough for the whole suite
MULTIPART_UPLOAD_RATE_LIMIT=10000
# Audience of the tokens forged by KeycloakClientTestMock: alchemy_core.app_name
API_AUDIENCE=expose
