{
    "name": "dashboard-client",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -H 0.0.0.0 -p 3000",
        "build": "next build",
        "start": "next start -H 0.0.0.0 -p 3000",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "cs": "pnpm lint:fix && pnpm format",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@alchemy/next-core": "workspace:*",
        "@alchemy/next-i18n": "workspace:*",
        "@alchemy/next-theme": "workspace:*",
        "@alchemy/next-ui": "workspace:*",
        "@tanstack/react-query": "^5.105.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^24.2.1",
        "lucide-react": "^1.67.0",
        "next": "^16.4.4",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.4",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.4",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    }
}
