{
    "name": "alchemy/mcp-bundle",
    "type": "symfony-bundle",
    "description": "MCP server shared by the Phrasea APIs: tools replayed as REST sub-requests, OAuth protected resource metadata, test helpers",
    "keywords": [
        "mcp",
        "model context protocol",
        "oauth"
    ],
    "homepage": "https://www.alchemy.fr/",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../auth-bundle",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "alchemy/auth-bundle": "@dev",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mcp-bundle": "^0.15",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix",
        "test": [
            "vendor/bin/var-dump-check --symfony --exclude vendor .",
            "vendor/bin/phpunit"
        ]
    },
    "autoload": {
        "psr-4": {
            "Alchemy\\McpBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alchemy\\McpBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "php-parallel-lint/php-var-dump-check": "v0.5",
        "phpunit/phpunit": "^11.5"
    }
}
