{
    "name": "alchemy/metadata-manipulator-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Metadata Manipulator bundle",
    "keywords": [],
    "homepage": "https://www.alchemy.fr/",
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/alchemy-fr/PHPExiftool"
        },
        {
            "type": "package",
            "package": {
                "name": "exiftool/exiftool",
                "version": "12",
                "source": {
                    "url": "https://github.com/exiftool/exiftool",
                    "type": "git",
                    "reference": "13.59"
                }
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "alchemy/phpexiftool": "^4.2.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Alchemy\\MetadataManipulatorBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "scripts": {
        "rector": "vendor/bin/rector",
        "cs": "vendor/bin/php-cs-fixer fix",
        "test": [
            "vendor/bin/var-dump-check --symfony src",
            "vendor/bin/phpunit"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Alchemy\\MetadataManipulatorBundle\\tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "php-parallel-lint/php-var-dump-check": "v0.5",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.3.0"
    }
}
