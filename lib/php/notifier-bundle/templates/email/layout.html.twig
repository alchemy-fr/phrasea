{#
    Common layout of the notification emails. Email clients only reliably
    honour tables and inline styles: the <style> block styles the topic body
    fragments (paragraphs, links, lists) where the clients support it, the
    structure itself never depends on it.
#}
{%- set primary = '#2563eb' -%}
{%- set font = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" -%}
<!DOCTYPE html>
<html lang="{{ locale|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ subject }}</title>
<style>
    .content p { margin: 0 0 16px; }
    .content a { color: {{ primary }}; text-decoration: underline; }
    .content ul, .content ol { margin: 0 0 16px; padding-left: 24px; }
    .content li { margin: 0 0 6px; }
    .content pre { margin: 0 0 16px; padding: 12px 16px; background: #f3f4f6; border-radius: 6px; font-size: 13px; white-space: pre-wrap; word-break: break-word; }
    @media only screen and (max-width: 620px) {
        .container { width: 100% !important; }
        .card-padding { padding: 24px 20px !important; }
        .header-padding { padding: 20px 20px !important; }
    }
</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #f3f4f6;">{{ preheader }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f3f4f6;">
    <tr>
        <td align="center" style="padding: 32px 12px;">
            <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 600px; max-width: 600px;">
                <tr>
                    <td style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="header-padding" style="padding: 24px 40px; border-bottom: 1px solid #e5e7eb;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="vertical-align: middle;">
                                                <img src="{{ logo.src }}" alt="{{ app_name }}"
                                                    {%- if logo.width %} width="{{ logo.width }}"{% endif %}
                                                    {%- if logo.height %} height="{{ logo.height }}"{% endif %}
                                                    style="display: block; border: 0; outline: none; text-decoration: none; max-width: 200px; max-height: 48px;{% if not logo.width %} height: auto;{% endif %}">
                                            </td>
                                            {%- if not logo.custom %}
                                            <td style="vertical-align: middle; padding-left: 12px; font-family: {{ font|raw }}; font-size: 20px; font-weight: 600; color: #111827;">{{ app_name }}</td>
                                            {%- endif %}
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td class="card-padding content" style="padding: 32px 40px; font-family: {{ font|raw }}; font-size: 15px; line-height: 24px; color: #1f2937;">
                                    {%- if subject %}
                                    <h1 style="margin: 0 0 24px; font-family: {{ font|raw }}; font-size: 20px; line-height: 28px; font-weight: 600; color: #111827;">{{ subject }}</h1>
                                    {%- endif %}
                                    {{ body|raw }}
                                    {%- if action_url %}
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top: 8px;">
                                        <tr>
                                            <td align="center" bgcolor="{{ primary }}" style="border-radius: 8px; background-color: {{ primary }};">
                                                <a href="{{ action_url }}" target="_blank" style="display: inline-block; padding: 12px 24px; font-family: {{ font|raw }}; font-size: 15px; font-weight: 600; line-height: 20px; color: #ffffff; text-decoration: none; border-radius: 8px;">{{ action_label|default('email_layout.action'|trans({}, 'notifications')) }}</a>
                                            </td>
                                        </tr>
                                    </table>
                                    {%- endif %}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding: 24px 40px 0; font-family: {{ font|raw }}; font-size: 12px; line-height: 18px; color: #6b7280;">
                        {{ 'email_layout.footer'|trans({'%app%': app_name}, 'notifications') }}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
