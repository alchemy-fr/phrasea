{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Broadcast a notification{% endblock %}

{% block main %}
    {{ form_start(form) }}
        {{ form_errors(form) }}

        {{ form_row(form.subject) }}
        {{ form_row(form.body) }}

        <hr>

        {{ form_row(form.url) }}
        {{ form_row(form.channels) }}
        {{ form_row(form.directory) }}
        {{ form_row(form.excludeMe) }}

        <button type="submit" class="btn btn-primary">Send</button>
    {{ form_end(form) }}
{% endblock %}
