{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro value(stat, value) %}{{ stat.format == 'bytes' ? value|file_size : value|number_format(0, '.', ',') }}{% endmacro %}

{% block content_title %}
    Home
{% endblock %}

{% block main %}
    {% if userNamesError is not null %}
        <p class="text-muted small"><i class="fa-solid fa-triangle-exclamation"></i> Cannot resolve the user names: {{ userNamesError }}</p>
    {% endif %}

    {% if stats is not empty %}
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-4 admin-home-stats">
            {% for stat in stats %}
                <div class="col">
                    {% set tag = stat.url is not null ? 'a' : 'div' %}
                    <{{ tag }} class="card h-100 text-decoration-none text-reset admin-home-stat"{% if stat.url is not null %} href="{{ stat.url }}"{% endif %}{% if stat.error is not null %} title="{{ stat.error }}"{% endif %}>
                        <div class="card-body">
                            <div class="text-muted"><i class="{{ stat.icon }} fa-fw"></i> {{ stat.label }}</div>
                            {% if stat.error is not null %}
                                <div class="fs-3 fw-bold">—</div>
                                <div class="small text-muted text-truncate">{{ stat.error }}</div>
                            {% else %}
                                <div class="fs-3 fw-bold">{{ _self.value(stat, stat.total) }}</div>
                                {% if stat.hasPeriods %}
                                    <div class="small text-muted">
                                        24h: {{ _self.value(stat, stat.last24h ?? 0) }}
                                        · 7d: {{ _self.value(stat, stat.last7d ?? 0) }}
                                        · 30d: {{ _self.value(stat, stat.last30d ?? 0) }}
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </{{ tag }}>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if charts is not empty %}
        <div class="row row-cols-1 row-cols-xl-3 g-3 mb-4 admin-home-charts">
            {% for chart in charts %}
                <div class="col">
                    <div class="card h-100 admin-home-chart">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="{{ chart.icon }} fa-fw"></i> {{ chart.title }}</span>
                            {% if chart.url is not null %}
                                <a href="{{ chart.url }}" class="small">See all</a>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            {% if chart.error is not null %}
                                <p class="text-danger mb-0">Cannot load the chart: {{ chart.error }}</p>
                            {% else %}
                                <div style="position: relative; height: 260px;">
                                    <canvas data-chart="{{ chart.toConfig|json_encode|e('html_attr') }}"></canvas>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if blocks is not empty %}
        <div class="row row-cols-1 row-cols-xl-2 g-3 admin-home-blocks">
            {% for block in blocks %}
                <div class="col">
                    <div class="card h-100 admin-home-block">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="{{ block.icon }} fa-fw"></i> {{ block.title }}</span>
                            {% if block.seeAllUrl is not null %}
                                <a href="{{ block.seeAllUrl }}" class="small">See all</a>
                            {% endif %}
                        </div>
                        <div class="card-body p-0">
                            {% if block.error is not null %}
                                <p class="text-danger m-3">Cannot load the latest items: {{ block.error }}</p>
                            {% else %}
                                <table class="table datagrid table-sm mb-0">
                                    <tbody>
                                    {% for item in block.items %}
                                        {% set userName = item.userName ?? (item.userId is not null ? userNames[item.userId] ?? null : null) %}
                                        <tr>
                                            <td class="text-nowrap" title="{{ item.date|date('Y-m-d H:i:s T') }}">{{ item.date|date('d/m/Y H:i') }}</td>
                                            <td>
                                                {% if item.url is not null %}
                                                    <a href="{{ item.url }}">{{ item.label }}</a>
                                                {% else %}
                                                    {{ item.label }}
                                                {% endif %}
                                            </td>
                                            <td class="text-muted">{{ item.detail }}</td>
                                            <td>
                                                {% if userName is not null %}
                                                    {{ userName }}
                                                {% elseif item.userId is not null %}
                                                    <code>{{ item.userId }}</code>
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                {% if item.status is not null %}
                                                    <span class="badge text-bg-{{ item.statusVariant ?? 'secondary' }}">{{ item.status }}</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-muted">No recent activity.</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    {% if charts is not empty %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js"
                integrity="sha512-Y51n9mtKTVBh3Jbx5pZSJNDDMyY+yGe77DGtBPzRlgsf/YLCh13kSZ3JmfHGzYFCmOndraf0sQgfM654b7dJ3w=="
                crossorigin="anonymous"></script>
        <script>
            (function () {
                if (typeof Chart === 'undefined') {
                    return;
                }

                const units = ['B', 'KB', 'MB', 'GB', 'TB'];
                const numberFormat = new Intl.NumberFormat('en-US', {maximumFractionDigits: 0});
                const formatBytes = function (value) {
                    let size = Number(value);
                    let unit = 0;
                    while (Math.abs(size) >= 1024 && unit < units.length - 1) {
                        size /= 1024;
                        ++unit;
                    }

                    return (0 === unit ? size.toFixed(0) : size.toFixed(1)) + ' ' + units[unit];
                };
                const format = function (type, value) {
                    return 'bytes' === type ? formatBytes(value) : numberFormat.format(value);
                };

                // Follows the EasyAdmin light/dark theme
                Chart.defaults.color = getComputedStyle(document.body).color;

                document.querySelectorAll('canvas[data-chart]').forEach(function (canvas) {
                    const config = JSON.parse(canvas.dataset.chart);
                    const formats = config.formats || {};
                    const datasetFormats = formats.datasets || [];
                    delete config.formats;

                    const options = config.options = config.options || {};
                    options.responsive = true;
                    options.maintainAspectRatio = false;
                    options.scales = options.scales || {};
                    Object.entries(formats.axes || {}).forEach(function ([axis, type]) {
                        const scale = options.scales[axis] = options.scales[axis] || {};
                        scale.ticks = Object.assign({}, scale.ticks, {
                            callback: function (value) {
                                return format(type, value);
                            },
                        });
                    });

                    options.plugins = options.plugins || {};
                    options.plugins.tooltip = options.plugins.tooltip || {};
                    options.plugins.tooltip.callbacks = Object.assign({}, options.plugins.tooltip.callbacks, {
                        label: function (context) {
                            const label = 'doughnut' === config.type ? context.label : context.dataset.label;
                            const value = format(datasetFormats[context.datasetIndex] || 'number', context.raw);

                            return label ? label + ': ' + value : value;
                        },
                    });

                    new Chart(canvas, config);
                });
            })();
        </script>
    {% endif %}
{% endblock %}
