{% extends '@EasyAdmin/page/content.html.twig' %}
{% set _request_parameters = app.request.query.all %}


{% block content_title %}
    Worker Queues
{% endblock %}

{% block main %}
     <table class="table datagrid">
        <thead>
            <tr>
                <th>Name</th>
                <th>Message count</th>
                <th>Consumer count</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for qs in queuesStatus %}
            <tr>
                <td>{{ qs.queueName }}</td>
                {% if qs.messageCount is null %}
                    <td colspan="3"><span class="text-danger">Not declared</span></td>
                {% else %}
                    <td>{{ qs.messageCount }}</td>
                    <td>{{ qs.consumerCount }}</td>
                    <td class="text-end">
                        <form method="post" action="{{ path(inspectRoute, {queue: qs.queueName}) }}" class="d-inline">
                            <input type="hidden" name="token" value="{{ csrf_token(csrfTokenId) }}">
                            {% if qs.messageCount > 0 %}
                                <button type="submit" class="btn btn-sm btn-secondary">Inspect</button>
                            {% else %}
                                <span class="d-inline-block" title="Queue is empty">
                                    <button type="submit" class="btn btn-sm btn-secondary" disabled>Inspect</button>
                                </span>
                            {% endif %}
                        </form>
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <p class="text-muted mt-3">
        Inspecting a queue reads its first {{ inspectLimit }} pending messages and publishes them again at its end:
        they are not lost nor retried, but they lose their position in the queue.
    </p>

    {% if inspectedQueue is not null %}
        <h2 class="mt-4">Pending messages in {{ inspectedQueue }}</h2>
        {% if inspectError is not null %}
            <div class="alert alert-danger">Inspection failed: {{ inspectError }}</div>
        {% elseif pendingMessages is null or pendingMessages.count == 0 %}
            <p class="text-muted">No pending message.</p>
        {% else %}
            {% set messageCount = queuesStatus[inspectedQueue].messageCount %}
            {% if messageCount > pendingMessages.count %}
                <p class="text-muted">
                    Sample of the first {{ pendingMessages.count }} messages out of {{ messageCount }}
                    (inspection limit: {{ inspectLimit }})
                </p>
            {% endif %}
            <table class="table datagrid">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Detail</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                {% for group in pendingMessages.groups %}
                    <tr>
                        <td title="{{ group.type ?? 'No type header' }}">{{ group.shortType }}</td>
                        <td>{{ group.detail }}</td>
                        <td>{{ group.count }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endblock %}
