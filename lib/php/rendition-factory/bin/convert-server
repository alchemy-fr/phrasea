#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__.'/remote-exec-autoload.php';

try {
    $server = Alchemy\RenditionFactory\RemoteExec\Server::fromEnvironment(getenv());
} catch (Alchemy\RenditionFactory\RemoteExec\RemoteExecException $e) {
    fwrite(STDERR, 'convert-server: '.$e->getMessage()."\n");
    exit(1);
}

exit($server->run());
