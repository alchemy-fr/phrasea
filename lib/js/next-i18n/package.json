{
    "name": "@alchemy/next-i18n",
    "version": "1.0.0",
    "private": true,
    "description": "Languages, i18next setup and common translations of the Next.js clients",
    "type": "module",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./createI18n": "./src/createI18n.ts",
        "./I18nProvider": "./src/I18nProvider.tsx",
        "./translations/*": "./translations/*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "cs": "pnpm lint:fix && pnpm format",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "i18next": "^24.2.1",
        "react": "^19.3.1",
        "react-i18next": "^15.7.4"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.4",
        "i18next": "^24.2.1",
        "jsdom": "^29.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    }
}
