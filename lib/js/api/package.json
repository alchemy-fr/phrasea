{
    "name": "@alchemy/api",
    "version": "0.0.1",
    "public": true,
    "description": "API library",
    "keywords": [],
    "main": "index.ts",
    "sideEffects": false,
    "license": "MIT",
    "scripts": {
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json|cjs|tsx|jsx)\"",
        "cs": "pnpm lint:fix && pnpm format",
        "test": "vitest run",
        "test:watch": "vitest",
        "translate": "i18next-scanner --config ../i18n/i18next-scanner.config.js"
    },
    "files": [
        "translations/*.json",
        "src/multiPartUpload.ts",
        "src/axiosMultipartUpload.ts",
        "src/mimeTypes.ts"
    ],
    "peerDependencies": {
        "axios": "^1.18.1",
        "axios-retry": "^4.5.0",
        "react": "^19.0.0",
        "react-hook-form": "^7.63.0",
        "react-i18next": "^15.0.0"
    },
    "devDependencies": {
        "@4rthem/i18next-scanner": "^0.0.3",
        "@types/react": "^19.3.3",
        "axios": "^1.21.0",
        "axios-retry": "^4.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-i18next": "^15.7.4",
        "react-toastify": "^11.2.0",
        "vitest": "^4.1.12"
    }
}
