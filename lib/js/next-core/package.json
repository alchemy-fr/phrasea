{
    "name": "@alchemy/next-core",
    "version": "1.0.0",
    "private": true,
    "description": "Plumbing of the Next.js clients: OIDC session, runtime and stack configuration, analytics",
    "type": "module",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./auth/oidc": "./src/auth/oidc.ts",
        "./auth/AuthCallbackPage": "./src/auth/AuthCallbackPage.tsx",
        "./auth/SessionExpiredDialog": "./src/auth/SessionExpiredDialog.tsx",
        "./config/createConfig": "./src/config/createConfig.tsx",
        "./config/stackConfig": "./src/config/stackConfig.ts",
        "./analytics/matomo": "./src/analytics/matomo.ts",
        "./analytics/MatomoTracker": "./src/analytics/MatomoTracker.tsx",
        "./server/http": "./src/server/http.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "cs": "pnpm lint:fix && pnpm format",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@alchemy/next-ui": "workspace:*"
    },
    "peerDependencies": {
        "next": "^16.4.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.4",
        "i18next": "^24.2.1",
        "jsdom": "^29.1.1",
        "next": "^16.4.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    }
}
