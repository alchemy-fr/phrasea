{
    "name": "@alchemy/next-ui",
    "version": "1.0.0",
    "private": true,
    "description": "Design system of the Next.js clients: UI components, modals, menus, base styles",
    "type": "module",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./utils/*": "./src/utils/*.ts",
        "./hooks/*": "./src/hooks/*.ts",
        "./navigation/*": "./src/navigation/*.ts",
        "./ui/*": "./src/ui/*.tsx",
        "./modals/*": "./src/modals/*.tsx",
        "./form/*": "./src/form/*.tsx",
        "./layout/*": "./src/layout/*.tsx",
        "./groups/types": "./src/groups/types.ts",
        "./groups/createGroupsApi": "./src/groups/createGroupsApi.ts",
        "./groups/*": "./src/groups/*.tsx",
        "./styles/*": "./styles/*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|json|cjs|mjs|tsx|jsx|css)\"",
        "cs": "pnpm lint:fix && pnpm format",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.105.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.67.0",
        "next": "^16.4.4",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@alchemy/next-i18n": "workspace:*",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.105.3",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.4",
        "i18next": "^24.2.1",
        "jsdom": "^29.1.1",
        "lucide-react": "^1.67.0",
        "next": "^16.4.4",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12",
        "zustand": "^5.0.16"
    }
}
