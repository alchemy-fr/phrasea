{
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../../lib/php/admin-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/configurator-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/test-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/storage-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/auth-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/notifier-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/api-test",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/report-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/report-sdk",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/core-bundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../lib/php/messenger-bundle",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "alchemy/acl-bundle": "^1.5.0",
        "alchemy/admin-bundle": "@dev",
        "alchemy/auth-bundle": "@dev",
        "alchemy/configurator-bundle": "@dev",
        "alchemy/core-bundle": "@dev",
        "alchemy/messenger-bundle": "@dev",
        "alchemy/notifier-bundle": "@dev",
        "alchemy/report-bundle": "@dev",
        "alchemy/storage-bundle": "@dev",
        "api-platform/core": "^5.0",
        "doctrine/common": "^3",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "fig/link-util": "^1.1",
        "guzzlehttp/guzzle": "^7.2",
        "nelmio/cors-bundle": "^2.1",
        "nyholm/psr7": "^1.1",
        "phpdocumentor/reflection-docblock": "^5.2",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "^7.2.4",
        "ramsey/uuid": "^4.2.3",
        "ramsey/uuid-doctrine": "^2.0",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/amqp-messenger": "^8.1",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.10",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/psr-http-message-bridge": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "api-platform/test": "^5.0",
        "ext-json": "*",
        "alchemy/api-test": "@dev",
        "alchemy/test-bundle": "*",
        "colinodell/psr-testlogger": "*",
        "friendsofphp/php-cs-fixer": "^3.17",
        "hautelook/alice-bundle": "^2.17",
        "php-parallel-lint/php-var-dump-check": "v0.5",
        "phpstan/phpstan": "^2.1.33",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.3.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\Unit\\": "tests/unit/",
            "App\\Tests\\Functional\\": "tests/functional/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "cache-clear": "php -d memory_limit=-1 bin/console cache:clear",
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@cache-clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@cache-clear",
            "@auto-scripts"
        ],
        "rector": "vendor/bin/rector",
        "phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "cs": "vendor/bin/php-cs-fixer fix",
        "pre-phpunit": [
            "rm -f var/cache/test/data*.db",
            "bin/console -e test doctrine:schema:create"
        ],
        "phpunit": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit"
        ],
        "phpunit:compact": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit --extension 'Alchemy\\ApiTest\\PHPUnit\\CompactResultExtension'"
        ],
        "var-dump-check": "vendor/bin/var-dump-check --symfony src",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@var-dump-check",
            "@phpstan",
            "@cs:check"
        ],
        "phpunit:unit": "php -d memory_limit=1024M vendor/bin/phpunit --testsuite unit",
        "phpunit:functional": [
            "@pre-phpunit",
            "php -d memory_limit=1024M ./bin/phpunit --testsuite functional"
        ],
        "test:quick": [
            "@lint",
            "@phpunit:unit"
        ],
        "test": [
            "@lint",
            "@phpunit"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    }
}
