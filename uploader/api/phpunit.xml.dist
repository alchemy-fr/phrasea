<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
        <env name="APP_ENV" value="test" force="true" />
        <env name="SHELL_VERBOSITY" value="-1" />
        <env name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <env name="SYMFONY_PHPUNIT_VERSION" value="9.6" />
    </php>

    <!--
        unit: plain TestCase classes without any service, played by the
        `quick` tier without the stack. functional: `tests` minus the unit
        entries (kernel, SQLite, minio), so a new test lands there by default.
        A test moves to `unit` only when listed in BOTH blocks.
    -->
    <testsuites>
        <testsuite name="unit">
            <file>tests/Consumer/CommitHandlerTest.php</file>
            <file>tests/Consumer/DownloadHandlerTest.php</file>
            <file>tests/PresignedUrlTest.php</file>
        </testsuite>
        <testsuite name="functional">
            <directory>tests</directory>
            <exclude>tests/Consumer/CommitHandlerTest.php</exclude>
            <exclude>tests/Consumer/DownloadHandlerTest.php</exclude>
            <exclude>tests/PresignedUrlTest.php</exclude>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
    </listeners>

    <extensions>
    </extensions>
</phpunit>
